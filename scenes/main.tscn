[node name="Hud" parent="." instance=ExtResource("4_hud")]

[node name="InventoryScreen" parent="." instance=ExtResource("19_inventoryscreen")]

[node name="PerformanceOverlay" parent="." instance=ExtResource("5_perfoverlay")]

; 세션 어댑터 경계 (설계서 9.1). 게임 코드는 SessionService 인터페이스만 본다.
; 로컬 2인 개발은 LocalSessionService, Steam 출시는 SteamSessionService 로 이 노드만 교체.
[node name="NetSession" type="Node" parent="."]
script = ExtResource("9_netsession")
config = ExtResource("11_netconfig")

[node name="DifficultyRuntime" type="Node" parent="."]
script = ExtResource("23_difficulty")

[node name="SaveService" type="Node" parent="."]
script = ExtResource("30_save")

[node name="PauseMenu" type="CanvasLayer" parent="."]
script = ExtResource("31_pause")

; 호스트가 권위적으로 스폰하는 원격 아바타 컨테이너.
[node name="Players" type="Node2D" parent="."]

; 2인 이동 동기화 + 호스트 권한 검증 (설계서 7.2/7.4).
; 싱글플레이는 peer 없는 동일 흐름이라 이 노드들이 있어도 네트워크 활동이 없다 (설계서 9.3).
[node name="NetMovement" type="Node" parent="."]
script = ExtResource("10_netmovement")
avatar_scene = ExtResource("2_player")
config = ExtResource("11_netconfig")

; 장비 변경 호스트 권위 — 클라이언트 의도 검증·확정 후 ID 스냅샷 복제.
; NetMovement 뒤에 두어 참가/재접속 시 아바타 스폰이 먼저 처리되게 한다.
[node name="NetEquipment" type="Node" parent="."]
script = ExtResource("22_netequipment")

[node name="NetCombat" type="Node" parent="."]
script = ExtResource("24_netcombat")

; 아이템 획득 호스트 권위 — 줍기 의도 검증·직렬 확정·복제 (설계서 7.2/7.4, W2-T2).
[node name="NetPickup" type="Node" parent="."]
script = ExtResource("12_netpickup")

[node name="NetBaseCamp" type="Node" parent="."]
script = ExtResource("29_netbasecamp")

; 피해·출혈·붕대 치료 호스트 권위 + 생존 스냅샷 복제 (설계서 7.2/5.2, W2-T2).
[node name="NetSurvival" type="Node" parent="."]
script = ExtResource("13_netsurvival")
config = ExtResource("11_netconfig")

; 모닥불 설치·점화 호스트 권위 — 재료·거리·자리 검증, 소등 복제 (설계서 5.8/7.2, W2-T5).
[node name="NetCampfire" type="Node" parent="."]
script = ExtResource("14_netcampfire")

; 퀵 제작 호스트 권위 — recipe_id 의도만 받고 재료·결과는 호스트 데이터로 확정.
[node name="NetCrafting" type="Node" parent="."]
script = ExtResource("18_netcrafting")

; 사체 해체 호스트 권위 — 사체 경로 의도만 받고 홀드 시간·거리·yield_mask 는
; 호스트가 확정한다 (W5-T2, 정본 §14.4). 이 노드가 없으면 해체가 로컬 경로로
; 떨어져 클라이언트가 즉시 완료를 주장할 수 있다.
[node name="NetButcher" type="Node" parent="."]
script = ExtResource("21_netbutcher")

; 재접속 전체 상태 재동기화 — 인벤토리·체력·출혈·위치 스냅샷 (설계서 6.3/7.3, W2-T5).
; ★ NetMovement 뒤에 있어야 한다: 재접속 처리 순서 = 아바타 스폰 → 상태 복원·스냅샷.
[node name="NetResync" type="Node" parent="."]
script = ExtResource("15_netresync")

; W6 압축 세션 시계 — 하루 10분(낮 7 + 황혼 1 + 밤 2) × 3일.
[node name="SessionClock" type="Node" parent="."]
script = ExtResource("16_sessionclock")
daylight_duration_seconds = 420.0
dusk_duration_seconds = 60.0
night_duration_seconds = 120.0
total_days = 3

; 루프 판정: 위험 노출(출혈) → 랩터 회피 → 이 지점 도달 = 성공 / 시간 만료 = 실패.
; 지점은 스폰(-384,200)의 반대편 남동쪽 평지다 — 랩터 스폰(-800,800)을 지나칠 필요는
; 없지만, 소리·냄새를 흘리며 대각선으로 가로질러야 할 만큼 멀다.
; ★ NetSession/Players/SessionClock 뒤에 둔다 — _ready 에서 이 노드들을 참조한다.
[node name="LoopObjective" type="Node2D" parent="."]
position = Vector2(640, 700)
script = ExtResource("17_loopobjective")
